    "eslint-plugin-react-refresh": "0.5.7",
    "jsdom": "30.1.3",
    "playwright": "1.62.1",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
